@page
@model SubmitModel
@{
    ViewData["Title"] = "提交博客";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4">提交博客</h2>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")">
                    @Model.Message
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.Name" class="form-label">博客名称</label>
                    <input asp-for="Input.Name" class="form-control" required />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Url" class="form-label">博客网址</label>
                    <input asp-for="Input.Url" class="form-control" type="url" required placeholder="https://example.com" />
                    <span asp-validation-for="Input.Url" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.RssUrl" class="form-label">RSS 链接</label>
                    <input asp-for="Input.RssUrl" class="form-control" type="url" required placeholder="https://example.com/feed" />
                    <span asp-validation-for="Input.RssUrl" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label">简介（可选）</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">提交</button>
            </form>
        </div>
    </div>
</div>
