@using BlogSwarm.Services
@inject DataService DataService

@{
    var stats = DataService.GetStats();
    var now = DateTime.Now;
    var firstDay = new DateTime(now.Year, now.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(now.Year, now.Month);
    var startDayOfWeek = (int)firstDay.DayOfWeek;
}

<div class="sidebar-card">
    <h5>🕐 数字时钟</h5>
    <div class="clock-display">
        <div id="clock-time" class="clock-time">00:00:00</div>
        <div id="clock-date" class="clock-date"></div>
    </div>
</div>

<div class="sidebar-card">
    <h5>📅 日历</h5>
    <table class="calendar-table">
        <tr>
            <th>日</th><th>一</th><th>二</th><th>三</th><th>四</th><th>五</th><th>六</th>
        </tr>
        @{
            var day = 1;
            for (int week = 0; week < 6 && day <= daysInMonth; week++)
            {
                <tr>
                    @for (int d = 0; d < 7; d++)
                    {
                        if ((week == 0 && d < startDayOfWeek) || day > daysInMonth)
                        {
                            <td></td>
                        }
                        else
                        {
                            var isToday = day == now.Day;
                            <td>
                                @if (isToday)
                                {
                                    <span class="today">@day</span>
                                }
                                else
                                {
                                    @day
                                }
                            </td>
                            day++;
                        }
                    }
                </tr>
            }
        }
    </table>
</div>

<div class="sidebar-card">
    <h5>📊 站点统计</h5>
    <div class="stats-item">
        <span>收录博客</span>
        <span class="value">@stats.BlogCount</span>
    </div>
    <div class="stats-item">
        <span>文章总数</span>
        <span class="value">@stats.ArticleCount</span>
    </div>
    @if (stats.LastUpdate.HasValue)
    {
        <div class="stats-item">
            <span>最后更新</span>
            <span class="value">@stats.LastUpdate.Value.ToString("MM-dd HH:mm")</span>
        </div>
    }
</div>

<div class="sidebar-card">
    <h5>💭 每日一言</h5>
    @{
        var quote = DataService.GetRandomQuote();
    }
    @if (quote.HasValue)
    {
        <p class="quote-text">"@quote.Value.Text"</p>
        @if (!string.IsNullOrEmpty(quote.Value.Author))
        {
            <p class="quote-author">—— @quote.Value.Author</p>
        }
    }
    else
    {
        <p class="quote-text">读取失败:-(</p>
        <p class="quote-author">—— Exyone Dev</p>
    }
</div>
