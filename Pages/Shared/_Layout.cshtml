<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BlogSwarm</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BlogSwarm.styles.css" asp-append-version="true" />
    <link rel="alternate" type="application/rss+xml" title="BlogSwarm RSS Feed" href="/feed" />
    <style>
        :root {
            --sidebar-bg: #fff;
            --card-border: #e9ecef;
            --text-muted: #6c757d;
            --link-color: #0d6efd;
            --header-height: 56px;
        }
        
        body {
            background-color: #f5f5f5;
            font-size: 14px;
            padding-top: var(--header-height);
        }
        
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
        }
        
        .main-container {
            display: flex;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 15px;
            gap: 15px;
        }
        
        .sidebar-left {
            width: 200px;
            flex-shrink: 0;
            position: sticky;
            top: calc(var(--header-height) + 15px);
            height: fit-content;
            max-height: calc(100vh - var(--header-height) - 30px);
            overflow-y: auto;
        }
        
        .sidebar-right {
            width: 250px;
            flex-shrink: 0;
            position: sticky;
            top: calc(var(--header-height) + 15px);
            height: fit-content;
            max-height: calc(100vh - var(--header-height) - 30px);
            overflow-y: auto;
        }
        
        .main-content {
            flex: 1;
            min-width: 0;
            background: #fff;
            border: 1px solid var(--card-border);
            padding: 15px;
        }
        
        .sidebar-card {
            background: #fff;
            border: 1px solid var(--card-border);
            margin-bottom: 15px;
            padding: 12px;
        }
        
        .sidebar-card h5 {
            font-size: 13px;
            font-weight: 600;
            color: #333;
            margin-bottom: 10px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--card-border);
        }
        
        .clock-display {
            text-align: center;
            padding: 8px 0;
        }
        
        .clock-time {
            font-size: 24px;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            color: #333;
        }
        
        .clock-date {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 4px;
        }
        
        .calendar-table {
            width: 100%;
            font-size: 11px;
            text-align: center;
        }
        
        .calendar-table th {
            padding: 3px;
            color: var(--text-muted);
            font-weight: normal;
        }
        
        .calendar-table td {
            padding: 3px;
        }
        
        .calendar-table .today {
            background: var(--link-color);
            color: #fff;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: inline-block;
            line-height: 20px;
        }
        
        .stats-item {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
            font-size: 12px;
            border-bottom: 1px dashed var(--card-border);
        }
        
        .stats-item:last-child {
            border-bottom: none;
        }
        
        .stats-item .value {
            font-weight: 600;
            color: var(--link-color);
        }
        
        .rank-item {
            display: flex;
            align-items: center;
            padding: 5px 0;
            font-size: 12px;
            border-bottom: 1px dashed var(--card-border);
        }
        
        .rank-item:last-child {
            border-bottom: none;
        }
        
        .rank-num {
            width: 18px;
            height: 18px;
            background: #e9ecef;
            border-radius: 50%;
            text-align: center;
            line-height: 18px;
            font-size: 10px;
            margin-right: 6px;
            flex-shrink: 0;
        }
        
        .rank-num.top3 {
            background: var(--link-color);
            color: #fff;
        }
        
        .rank-item a {
            color: #333;
            text-decoration: none;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            flex: 1;
        }
        
        .rank-item a:hover {
            color: var(--link-color);
        }
        
        .rank-item .count {
            color: var(--text-muted);
            font-size: 11px;
            margin-left: auto;
            padding-left: 6px;
        }
        
        .blog-item {
            padding: 6px 0;
            border-bottom: 1px dashed var(--card-border);
            font-size: 12px;
        }
        
        .blog-item:last-child {
            border-bottom: none;
        }
        
        .blog-item a {
            color: #333;
            text-decoration: none;
            font-weight: 500;
        }
        
        .blog-item a:hover {
            color: var(--link-color);
        }
        
        .blog-item .desc {
            color: var(--text-muted);
            font-size: 11px;
            margin-top: 2px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        
        .article-item {
            padding: 6px 0;
            border-bottom: 1px dashed var(--card-border);
            font-size: 12px;
        }
        
        .article-item:last-child {
            border-bottom: none;
        }
        
        .article-item a {
            color: #333;
            text-decoration: none;
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        
        .article-item a:hover {
            color: var(--link-color);
        }
        
        .article-item .meta {
            font-size: 10px;
            color: var(--text-muted);
            margin-top: 2px;
        }
        
        .quote-text {
            font-size: 12px;
            color: #555;
            line-height: 1.5;
            font-style: italic;
        }
        
        .quote-author {
            text-align: right;
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 6px;
        }
        
        .link-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        
        .link-list li {
            padding: 4px 0;
        }
        
        .link-list a {
            color: #333;
            text-decoration: none;
            font-size: 12px;
        }
        
        .link-list a:hover {
            color: var(--link-color);
        }
        
        .article-list {
            margin-bottom: 15px;
        }
        
        .article-card {
            padding: 12px 0;
            border-bottom: 1px dashed var(--card-border);
        }
        
        .article-card:last-child {
            border-bottom: none;
        }
        
        .article-title {
            margin-bottom: 6px;
        }
        
        .article-title a {
            color: #333;
            text-decoration: none;
            font-size: 15px;
            font-weight: 500;
        }
        
        .article-title a:hover {
            color: var(--link-color);
        }
        
        .article-desc {
            color: var(--text-muted);
            font-size: 13px;
            margin-bottom: 6px;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        .article-meta {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: var(--text-muted);
        }
        
        .article-meta a {
            color: var(--text-muted);
            text-decoration: none;
        }
        
        .article-meta a:hover {
            color: var(--link-color);
        }
        
        .pagination {
            margin-bottom: 0;
        }
        
        .pagination .page-link {
            font-size: 12px;
            padding: 4px 10px;
        }
        
        @@media (max-width: 1200px) {
            .sidebar-left {
                width: 180px;
            }
            .sidebar-right {
                width: 220px;
            }
        }
        
        @@media (max-width: 992px) {
            .sidebar-left,
            .sidebar-right {
                display: none;
            }
            
            .main-container {
                padding: 0 10px;
            }
            
            .main-content {
                padding: 12px;
            }
        }
        
        @@media (max-width: 576px) {
            .article-title a {
                font-size: 14px;
            }
            
            .article-desc {
                font-size: 12px;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">BlogSwarm</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">首页</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Submit">提交博客</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Review">审核</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/feed" target="_blank" title="RSS 订阅">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2zm1.5 2.5c5.523 0 10 4.477 10 10a1 1 0 1 1-2 0 8 8 0 0 0-8-8 1 1 0 0 1 0-2zm0 4a6 6 0 0 1 6 6 1 1 0 1 1-2 0 4 4 0 0 0-4-4 1 1 0 0 1 0-2zm.5 7a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
                                </svg>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="apiDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                API
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="apiDropdown">
                                <li><a class="dropdown-item" href="/api/stats" target="_blank">统计数据</a></li>
                                <li><a class="dropdown-item" href="/api/blogs" target="_blank">博客列表</a></li>
                                <li><a class="dropdown-item" href="/api/articles" target="_blank">文章列表</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-container mt-3">
        <aside class="sidebar-left">
            @await Html.PartialAsync("_SidebarLeft")
        </aside>
        
        <main class="main-content">
            @RenderBody()
        </main>
        
        <aside class="sidebar-right">
            @await Html.PartialAsync("_SidebarRight")
        </aside>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container text-center py-3">
            &copy; 2026 - BlogSwarm · 开放 · 轻量 · 聚合文章
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function updateClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            
            document.getElementById('clock-time').textContent = `${hours}:${minutes}:${seconds}`;
            
            const weekDays = ['日', '一', '二', '三', '四', '五', '六'];
            const year = now.getFullYear();
            const month = now.getMonth() + 1;
            const day = now.getDate();
            const weekDay = weekDays[now.getDay()];
            
            document.getElementById('clock-date').textContent = `${year}年${month}月${day}日 星期${weekDay}`;
        }
        
        updateClock();
        setInterval(updateClock, 1000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
