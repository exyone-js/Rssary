@page "{id?}"
@model BlogModel
@{
    ViewData["Title"] = Model.BlogNotFound ? "博客未找到" : Model.Blog?.Name ?? "博客详情";
    Layout = "_Layout";
}

@if (Model.BlogNotFound)
{
    <div class="text-center py-5">
        <h2>博客未找到</h2>
        <p class="text-muted">该博客不存在或尚未通过审核。</p>
        <a asp-page="/Index" class="btn btn-primary btn-sm">返回首页</a>
    </div>
}
else if (Model.Blog != null)
{
    <div class="mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Index">首页</a></li>
                <li class="breadcrumb-item active">@Model.Blog.Name</li>
            </ol>
        </nav>
    </div>

    <div class="blog-header mb-4">
        <h2 class="h5 mb-2">@Model.Blog.Name</h2>
        @if (!string.IsNullOrEmpty(Model.Blog.Description))
        {
            <p class="text-muted mb-2 small">@Model.Blog.Description</p>
        }
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Model.Blog.Url" target="_blank" class="btn btn-outline-primary btn-sm">访问博客</a>
            <a href="@Model.Blog.RssUrl" target="_blank" class="btn btn-outline-secondary btn-sm">RSS 订阅</a>
        </div>
        <div class="text-muted mt-2 small">展示最近 @Model.Articles.Count 篇文章</div>
    </div>

    @if (!Model.Articles.Any())
    {
        <div class="text-center text-muted py-4">
            <p>暂无文章</p>
        </div>
    }
    else
    {
        <div class="article-list">
            @foreach (var article in Model.Articles)
            {
                <div class="article-card">
                    <div class="article-title">
                        <a href="@article.Link" target="_blank">@article.Title</a>
                    </div>
                    @if (!string.IsNullOrEmpty(article.Description))
                    {
                        <div class="article-desc">@article.Description</div>
                    }
                    <div class="article-meta">
                        <span>
                            @if (!string.IsNullOrEmpty(article.Author))
                            {
                                @article.Author
                            }
                        </span>
                        <span>@article.PublishedAt.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                </div>
            }
        </div>
    }
}
